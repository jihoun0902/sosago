x = int(input()) # 출력할 월

print("일 월 화 수 목 금 토")

days = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]

start_day = 4 # 1월 1일 = 목요일

# 입력한 월까지 start_day 계산
for i in range(x - 1):
    start_day = (start_day + days[i]) % 7

# 시작 공백 출력
for _ in range(start_day):
    print("  ", end="")

# 날짜 출력
for j in range(1, days[x - 1] + 1):
    print(f"{j:2}", end=" ")

    if (start_day + j) % 7 == 0:
        print()